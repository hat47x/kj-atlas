    {"id":"c03","x":660,"y":80,"text":"frontend remote/common decoderでも同じ二値を必須にし、R18で分離したfallback固有metadataは再混入させない。","claimType":"fact","textReviewed":false,"meta":{"source":"frontend api/client.ts"}},
    {"id":"c04","x":60,"y":380,"text":"決定論fallbackとlocal mockは近接候補探索の性質に合わせてnear_duplicateだけを明示する。","claimType":"fact","textReviewed":false,"meta":{"source":"merge_candidates.ts + mock_local_llm.py"}},
    {"id":"c05","x":360,"y":380,"text":"kernel_fusionはremote providerが明示して返すことができるが、fallbackが行ったと推測しない。","claimType":"claim","textReviewed":false,"meta":{"source":"R20 boundary"}},
    {"id":"c06","x":660,"y":380,"text":"remote AIとfallbackは方法語彙を共有しても、候補生成の内部責務は分離したままにする。","claimType":"claim","textReviewed":false,"meta":{"source":"R18/R20 synthesis"}},
    {"id":"c07","x":60,"y":680,"text":"提案UIでは統合方式をAI rationaleと人間判断理由の間に独立表示し、04ステップ型／核融合法型と読めるようにした。","claimType":"fact","textReviewed":false,"meta":{"source":"MergeSuggestionsPanel.tsx"}},
    {"id":"c08","x":360,"y":680,"text":"新しいdecision書き込みではmergeMethodを必須にし、Appは現在のproposal値をそのままappendMergeSuggestionDecisionへ渡す。","claimType":"fact","textReviewed":false,"meta":{"source":"App.tsx + merge_suggestion_decisions.ts"}},
